---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import PostList from '../../../components/PostList.astro';
import { categoryDescription, categoryLabel } from '../../../categories';

// 실제로 쓰인 카테고리마다 페이지를 하나씩 만든다.
// 새 카테고리로 글을 쓰면 다음 빌드에 페이지가 저절로 생긴다.
export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const slugs = [...new Set(posts.map((p) => p.data.category))];

	return slugs.map((category) => ({
		params: { category },
		props: {
			posts: posts
				.filter((p) => p.data.category === category)
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { category } = Astro.params;
const { posts } = Astro.props;
const label = categoryLabel(category!);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={label}
			description={categoryDescription(category!)}
		/>
	</head>
	<body>
		<Header />
		<main>
			<p class="label settle">Topic</p>
			<h1 class="settle">{label}</h1>
			<p class="intro settle" style="--d: 40ms">{categoryDescription(category!)}</p>
			<div class="settle" style="--d: 70ms">
				<CategoryNav current={category} />
			</div>
			<PostList posts={posts} />
		</main>
		<Footer />
	</body>
</html>

<style>
	h1 {
		margin-bottom: 0.45rem;
	}
	.intro {
		color: var(--muted);
		margin-bottom: 1.25rem;
	}
</style>
