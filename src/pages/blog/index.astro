---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title="전체 글"
			description="게임, 디지털 도구, 생활 정보를 주제별로 찾아볼 수 있습니다."
		/>
	</head>
	<body>
		<Header />
		<main>
			<p class="label settle">Knowledge library</p>
			<h1 class="settle">전체 글</h1>
			<p class="intro settle" style="--d: 40ms">
				필요한 답을 찾기 쉽도록 주제별로 정리했습니다. 글은 최신 정보가 확인될 때마다
				수정일을 함께 표시합니다.
			</p>
			<div class="settle" style="--d: 70ms">
				<CategoryNav />
			</div>
			<PostList posts={posts} />
		</main>
		<Footer />
	</body>
</html>

<style>
	h1 {
		margin-bottom: 0.45rem;
	}
	.intro {
		color: var(--muted);
		margin-bottom: 1.25rem;
	}
</style>
