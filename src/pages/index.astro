---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);

const pad = (n: number) => String(n).padStart(2, '0');
const fmt = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro settle">
				<h1>gomdore</h1>
				<p class="bio">
					직접 써보고 정리합니다.<br />
					게임, 화장품, 생활용품 — 사기 전에 알았으면 좋았을 것들을 남겨요.
				</p>
			</section>

			<section class="recent">
				<h2 class="label settle" style="--d: 80ms">Recent posts</h2>
				<ul class="list">
					{
						posts.map((post, i) => (
							<li class="settle" style={`--d: ${150 + i * 45}ms`}>
								<a href={`/blog/${post.id}/`}>
									<span class="t">{post.data.title}</span>
									<span class="leader" aria-hidden="true" />
									<time datetime={fmt(post.data.pubDate)}>{fmt(post.data.pubDate)}</time>
								</a>
							</li>
						))
					}
				</ul>
				<p class="more settle" style={`--d: ${150 + posts.length * 45}ms`}>
					<a href="/blog">View all posts <span class="arrow" aria-hidden="true">→</span></a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		margin-bottom: 3.2rem;
	}
	.intro h1 {
		font-size: 1.45rem;
		margin-bottom: 0.7rem;
	}
	.bio {
		color: var(--muted);
		margin: 0;
	}

	.recent .label {
		display: block;
		margin-bottom: 0.9rem;
	}
	.list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.list a {
		display: flex;
		align-items: baseline;
		gap: 0.9rem;
		padding: 0.45rem 0;
	}
	.list .t {
		color: var(--text);
		font-weight: 500;
		transition: color 0.15s ease;
	}
	.list a:hover .t {
		color: var(--accent);
	}
	.list .leader {
		flex: 1;
		min-width: 2rem;
		border-bottom: 1px dotted var(--border);
		transform: translateY(-0.25em);
		transition: border-color 0.2s ease;
	}
	.list time {
		font-size: 0.78rem;
		color: var(--faint);
		flex-shrink: 0;
		transition: color 0.2s ease;
	}
	/* 제목만 반응하면 줄이 끊겨 보인다. 점선과 날짜까지 같이 살아나야
	   한 줄 전체가 하나의 대상으로 읽힌다. */
	.list a:hover .leader {
		border-bottom-color: var(--faint);
	}
	.list a:hover time {
		color: var(--muted);
	}
	.more {
		margin-top: 1.6rem;
	}
	.more a {
		font-family: var(--mono);
		font-size: 0.82rem;
		color: var(--muted);
	}
	.more a:hover {
		color: var(--text);
	}
	.more .arrow {
		display: inline-block;
		transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.more a:hover .arrow {
		transform: translateX(3px);
	}

	@media (max-width: 640px) {
		.list time {
			font-size: 0.72rem;
		}
	}
</style>
