---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);

const pad = (n: number) => String(n).padStart(2, '0');
const fmt = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>gomdore</h1>
				<p class="bio">
					느린 기록을 쌓아가는 공간입니다.<br />
					일하며 배운 것, 읽고 생각한 것을 씁니다.
				</p>
			</section>

			<section class="recent">
				<h2 class="label">Recent posts</h2>
				<ul class="list">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<span class="t">{post.data.title}</span>
									<span class="leader" aria-hidden="true" />
									<time datetime={fmt(post.data.pubDate)}>{fmt(post.data.pubDate)}</time>
								</a>
							</li>
						))
					}
				</ul>
				<p class="more"><a href="/blog">View all posts →</a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		margin-bottom: 3.2rem;
	}
	.intro h1 {
		font-size: 1.45rem;
		margin-bottom: 0.7rem;
	}
	.bio {
		color: var(--muted);
		margin: 0;
	}

	.recent .label {
		display: block;
		margin-bottom: 0.9rem;
	}
	.list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.list a {
		display: flex;
		align-items: baseline;
		gap: 0.9rem;
		padding: 0.45rem 0;
	}
	.list .t {
		color: var(--text);
		font-weight: 500;
		transition: color 0.15s ease;
	}
	.list a:hover .t {
		color: var(--accent);
	}
	.list .leader {
		flex: 1;
		min-width: 2rem;
		border-bottom: 1px dotted var(--border);
		transform: translateY(-0.25em);
	}
	.list time {
		font-size: 0.78rem;
		color: var(--faint);
		flex-shrink: 0;
	}
	.more {
		margin-top: 1.6rem;
	}
	.more a {
		font-family: var(--mono);
		font-size: 0.82rem;
		color: var(--muted);
	}
	.more a:hover {
		color: var(--text);
	}

	@media (max-width: 640px) {
		.list time {
			font-size: 0.72rem;
		}
	}
</style>
