---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import {
	CATEGORY_LABELS,
	categoryDescription,
	categoryLabel,
} from '../categories';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featured = allPosts.find((post) => post.data.featured) ?? allPosts[0];
const latest = allPosts.filter((post) => post.id !== featured?.id).slice(0, 4);

const counts = new Map<string, number>();
for (const post of allPosts) {
	counts.set(post.data.category, (counts.get(post.data.category) ?? 0) + 1);
}
const categories = Object.keys(CATEGORY_LABELS)
	.filter((slug) => counts.has(slug))
	.sort((a, b) => (counts.get(b) ?? 0) - (counts.get(a) ?? 0));

const pad = (n: number) => String(n).padStart(2, '0');
const fmt = (d: Date) =>
	`${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero settle">
				<p class="label">Practical knowledge</p>
				<h1>{SITE_TAGLINE}</h1>
				<p class="lede">
					게임, 디지털 도구, 생활 정보를 직접 확인하고 정리합니다.<br />
					결론부터 읽고, 필요한 경우 근거와 조건까지 확인할 수 있습니다.
				</p>
				<div class="hero-actions">
					<a class="primary" href="/blog">전체 글 보기</a>
					<a class="secondary" href="/about">콘텐츠 작성 기준</a>
				</div>
			</section>

			{
				featured && (
					<section class="featured settle" style="--d: 70ms">
						<div class="section-head">
							<div>
								<p class="label">Featured guide</p>
								<h2>먼저 읽어볼 글</h2>
							</div>
						</div>
						<a class="featured-card" href={`/blog/${featured.id}/`}>
							{featured.data.heroImage && (
								<Image
									src={featured.data.heroImage}
									alt=""
									widths={[480, 800, 1200]}
									sizes="(max-width: 720px) 100vw, 44vw"
									loading="eager"
								/>
							)}
							<span class="featured-copy">
								<span class="meta">
									{categoryLabel(featured.data.category)} ·{' '}
									<time datetime={fmt(featured.data.pubDate)}>
										{fmt(featured.data.pubDate)}
									</time>
								</span>
								<strong>{featured.data.title}</strong>
								<span class="desc">{featured.data.description}</span>
								<span class="read">가이드 읽기 <span aria-hidden="true">→</span></span>
							</span>
						</a>
					</section>
				)
			}

			<section class="topics settle" style="--d: 110ms">
				<div class="section-head">
					<div>
						<p class="label">Topics</p>
						<h2>주제별로 찾기</h2>
					</div>
				</div>
				<div class="topic-grid">
					{
						categories.map((slug) => (
							<a href={`/blog/category/${slug}/`}>
								<span class="topic-top">
									<strong>{categoryLabel(slug)}</strong>
									<span>{counts.get(slug)}개</span>
								</span>
								<span>{categoryDescription(slug)}</span>
							</a>
						))
					}
				</div>
			</section>

			<section class="latest settle" style="--d: 150ms">
				<div class="section-head">
					<div>
						<p class="label">Latest</p>
						<h2>최근 업데이트</h2>
					</div>
					<a href="/blog">전체 보기 →</a>
				</div>
				<ul>
					{
						latest.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<span class="post-meta">
										{categoryLabel(post.data.category)}
										<time datetime={fmt(post.data.pubDate)}>
											{fmt(post.data.updatedDate ?? post.data.pubDate)}
										</time>
									</span>
									<strong>{post.data.title}</strong>
									<span class="desc">{post.data.description}</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="standards settle" style="--d: 190ms">
				<p class="label">Editorial standards</p>
				<h2>정보는 확인하고, 광고는 구분합니다.</h2>
				<div>
					<p><strong>조건까지 설명</strong><span>누구에게나 맞는다는 결론 대신 적용 조건과 한계를 함께 씁니다.</span></p>
					<p><strong>수정일 공개</strong><span>정책이나 사양이 바뀌면 내용을 다시 확인하고 수정일을 표시합니다.</span></p>
					<p><strong>제휴 관계 표시</strong><span>수수료가 발생하는 링크는 본문보다 먼저 알아볼 수 있게 고지합니다.</span></p>
				</div>
				<a href="/about">운영 원칙 자세히 보기 →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		width: 68rem;
		padding-top: 4.4rem;
	}
	.hero {
		max-width: 47rem;
		padding-bottom: 4rem;
	}
	.hero h1 {
		font-size: clamp(2rem, 5vw, 3.25rem);
		line-height: 1.18;
		letter-spacing: -0.04em;
		margin: 0.6rem 0 1rem;
	}
	.lede {
		color: var(--muted);
		font-size: 1.08rem;
		line-height: 1.8;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 1.7rem;
	}
	.hero-actions a {
		border-radius: 7px;
		font-size: 0.9rem;
		font-weight: 600;
		padding: 0.7rem 1rem;
	}
	.primary {
		background: var(--text);
		color: var(--bg);
	}
	.secondary {
		border: 1px solid var(--border);
		color: var(--muted);
	}
	.section-head {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.section-head h2 {
		font-size: 1.25rem;
		margin-top: 0.2rem;
	}
	.section-head > a {
		color: var(--muted);
		font-family: var(--mono);
		font-size: 0.76rem;
	}
	.featured,
	.topics,
	.latest {
		border-top: 1px solid var(--border);
		padding: 2.5rem 0;
	}
	.featured-card {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
		border: 1px solid var(--border);
		border-radius: 12px;
		overflow: hidden;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}
	.featured-card:hover {
		border-color: var(--faint);
		transform: translateY(-2px);
	}
	.featured-card :global(img) {
		width: 100%;
		height: 100%;
		min-height: 19rem;
		object-fit: cover;
		border-radius: 0;
	}
	.featured-copy {
		display: flex;
		flex-direction: column;
		padding: 2.1rem;
	}
	.meta,
	.post-meta {
		color: var(--accent);
		font-family: var(--mono);
		font-size: 0.72rem;
	}
	.featured-copy strong {
		color: var(--text);
		font-size: 1.55rem;
		line-height: 1.4;
		margin: 0.8rem 0 0.7rem;
	}
	.desc {
		color: var(--muted);
		font-size: 0.92rem;
		line-height: 1.7;
	}
	.read {
		color: var(--text);
		font-family: var(--mono);
		font-size: 0.78rem;
		margin-top: auto;
		padding-top: 1.5rem;
	}
	.topic-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.7rem;
	}
	.topic-grid > a {
		border: 1px solid var(--border);
		border-radius: 9px;
		padding: 1.1rem;
		transition:
			border-color 0.2s ease,
			background 0.2s ease;
	}
	.topic-grid > a:hover {
		background: var(--bg-code);
		border-color: var(--faint);
	}
	.topic-top {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.45rem;
	}
	.topic-top strong {
		color: var(--text);
	}
	.topic-top span {
		color: var(--faint);
		font-family: var(--mono);
		font-size: 0.72rem;
	}
	.topic-grid > a > span:last-child {
		color: var(--muted);
		font-size: 0.84rem;
		line-height: 1.6;
	}
	.latest ul {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.latest li {
		border-top: 1px solid var(--border);
	}
	.latest li:nth-child(odd) {
		padding-right: 1.4rem;
	}
	.latest li:nth-child(even) {
		border-left: 1px solid var(--border);
		padding-left: 1.4rem;
	}
	.latest a {
		display: block;
		padding: 1.2rem 0 1.4rem;
	}
	.post-meta {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}
	.post-meta time {
		color: var(--faint);
	}
	.latest strong {
		display: block;
		color: var(--text);
		font-size: 1.05rem;
		margin: 0.45rem 0 0.25rem;
	}
	.latest a:hover strong {
		color: var(--accent);
	}
	.standards {
		background: var(--bg-code);
		border-radius: 12px;
		margin-top: 2.5rem;
		padding: 2rem;
	}
	.standards h2 {
		font-size: 1.4rem;
		margin: 0.35rem 0 1.3rem;
	}
	.standards > div {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.2rem;
	}
	.standards p {
		margin: 0;
	}
	.standards strong,
	.standards span {
		display: block;
	}
	.standards span {
		color: var(--muted);
		font-size: 0.84rem;
		line-height: 1.65;
		margin-top: 0.35rem;
	}
	.standards > a {
		display: inline-block;
		color: var(--muted);
		font-family: var(--mono);
		font-size: 0.78rem;
		margin-top: 1.4rem;
	}
	@media (max-width: 760px) {
		.home {
			padding-top: 3rem;
		}
		.featured-card {
			grid-template-columns: 1fr;
		}
		.featured-card :global(img) {
			min-height: 13rem;
			max-height: 18rem;
		}
		.featured-copy {
			padding: 1.4rem;
		}
		.topic-grid,
		.standards > div {
			grid-template-columns: 1fr;
		}
		.latest ul {
			grid-template-columns: 1fr;
		}
		.latest li:nth-child(odd),
		.latest li:nth-child(even) {
			border-left: 0;
			padding-left: 0;
			padding-right: 0;
		}
	}
</style>
