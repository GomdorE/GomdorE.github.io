---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title="페이지를 찾을 수 없습니다"
			description="요청한 페이지가 없거나 주소가 변경되었습니다."
		/>
	</head>
	<body>
		<Header />
		<main>
			<p class="code settle">404</p>
			<h1 class="settle" style="--d: 70ms">페이지를 찾을 수 없습니다</h1>
			<p class="desc settle" style="--d: 140ms">
				주소가 바뀌었거나, 삭제된 페이지일 수 있어요.
			</p>
			<p class="settle" style="--d: 210ms">
				<a class="home" href="/"><span class="arrow" aria-hidden="true">←</span> 홈으로 돌아가기</a>
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		padding-top: 5rem;
	}
	.code {
		font-family: var(--mono);
		font-size: 0.85rem;
		color: var(--accent);
		margin-bottom: 0.5rem;
	}
	.desc {
		color: var(--muted);
	}
	.home {
		font-family: var(--mono);
		font-size: 0.85rem;
		color: var(--muted);
	}
	.home:hover {
		color: var(--text);
	}
	.home .arrow {
		display: inline-block;
		transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.home:hover .arrow {
		transform: translateX(-3px);
	}
</style>
