---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { categoryLabel } from '../categories';

type Props = CollectionEntry<'blog'>['data'] & {
	pageType?: 'article' | 'page';
};

const CONTENT_TYPE_LABELS = {
	guide: '가이드',
	review: '리뷰',
	comparison: '비교',
	news: '소식',
} as const;

const {
	title,
	description,
	pubDate,
	updatedDate,
	category,
	heroImage,
	affiliate,
	contentType = 'guide',
	summary,
	sources,
	pageType = 'article',
} = Astro.props;
---

<html lang="ko">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			type={pageType === 'article' ? 'article' : 'website'}
			pubDate={pubDate}
			updatedDate={updatedDate}
			category={category && categoryLabel(category)}
		/>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header class="post-header settle">
					{
						pageType === 'article' && (
							<p class="eyebrow">
								{CONTENT_TYPE_LABELS[contentType as keyof typeof CONTENT_TYPE_LABELS]}
							</p>
						)
					}
					<h1>{title}</h1>
					<p class="dek">{description}</p>
					<p class="meta">
						{
							category && (
								<>
									<a class="cat" href={`/blog/category/${category}/`}>
										{categoryLabel(category)}
									</a>
									<span aria-hidden="true"> · </span>
								</>
							)
						}
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
									<span class="updated">
										· 수정 <FormattedDate date={updatedDate} />
								</span>
							)
						}
						<span id="reading-time"></span>
					</p>
				</header>

				{
						heroImage && (
							<Image
								class="hero settle"
								style="--d: 60ms"
								src={heroImage}
								alt=""
								widths={[480, 800, 1344]}
								sizes="(max-width: 42rem) 100vw, 42rem"
								loading="eager"
							/>
						)
					}

				<div class="prose post-body settle" style="--d: 90ms">
						{
							summary && (
								<aside class="summary" aria-labelledby="summary-title">
									<h2 id="summary-title">핵심 요약</h2>
									<ul>
										{summary.map((item) => <li>{item}</li>)}
									</ul>
								</aside>
							)
						}
						{
							affiliate && (
								<p class="affiliate-notice">
									이 글에는 쿠팡 파트너스 링크가 포함되어 있으며, 이를 통해 일정액의
									수수료를 제공받습니다. 구매자에게 추가로 부과되는 비용은 없습니다.
								</p>
							)
						}
						<slot />
						{
							sources && sources.length > 0 && (
								<section class="sources" aria-labelledby="sources-title">
									<h2 id="sources-title">참고 자료</h2>
									<ul>
										{sources.map((source) => (
											<li>
												<a href={source.url} rel="noopener noreferrer">
													{source.title}
												</a>
											</li>
										))}
									</ul>
								</section>
							)
						}
					</div>

				<footer class="post-footer settle" style="--d: 180ms">
					<p>내용이 바뀌었거나 잘못된 부분이 있으면 운영 원칙의 안내에 따라 수정합니다.</p>
					<a href="/blog"><span class="arrow" aria-hidden="true">←</span> 전체 글 보기</a>
				</footer>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-header {
		margin-bottom: 2.4rem;
	}
	.eyebrow {
		font-family: var(--mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		color: var(--accent);
		margin-bottom: 0.65rem;
	}
	.post-header h1 {
		font-size: 1.75rem;
		line-height: 1.35;
		margin-bottom: 0.8rem;
	}
	.dek {
		color: var(--muted);
		font-size: 1.02rem;
		line-height: 1.7;
		margin-bottom: 1rem;
	}
	.meta {
		font-family: var(--mono);
		font-size: 0.78rem;
		color: var(--faint);
		margin: 0;
	}
	.hero {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 1;
		object-fit: cover;
		border-radius: 8px;
		margin-bottom: 2.4rem;
	}
	.cat {
		color: var(--accent);
		background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px
			no-repeat;
		padding-bottom: 3px;
		transition: background-size 0.25s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.cat:hover {
		background-size: 100% 1px;
	}
	.sources {
		border-top: 1px solid var(--border);
		margin-top: 3rem;
		padding-top: 1rem;
	}
	.sources h2 {
		font-size: 1rem;
		margin-top: 0;
	}
	.sources ul {
		margin-bottom: 0;
	}
	.sources a {
		font-size: 0.9rem;
	}
	.post-footer {
		border-top: 1px solid var(--border);
		margin-top: 3.5rem;
		padding-top: 1.6rem;
	}
	.post-footer p {
		color: var(--faint);
		font-size: 0.82rem;
		margin-bottom: 0.8rem;
	}
	.post-footer a {
		font-family: var(--mono);
		font-size: 0.82rem;
		color: var(--muted);
	}
	.post-footer a:hover {
		color: var(--text);
	}
	.post-footer .arrow {
		display: inline-block;
		transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.post-footer a:hover .arrow {
		transform: translateX(-3px);
	}
</style>

<script is:inline>
	(function () {
		var el = document.getElementById('reading-time');
		var body = document.querySelector('.post-body');
		if (!el || !body) return;
		var chars = (body.textContent || '').replace(/\s+/g, '').length;
		var min = Math.max(1, Math.round(chars / 500));
		el.textContent = ' · ' + min + ' min read';

		document.querySelectorAll('.yt[data-id]').forEach(function (container) {
			var id = container.getAttribute('data-id');
			if (!id || !/^[\w-]{6,20}$/.test(id)) return;

			var button = document.createElement('button');
			button.className = 'yt-play';
			button.type = 'button';
			button.setAttribute('aria-label', 'YouTube 영상 재생');

			var thumbnail = document.createElement('img');
			thumbnail.src = 'https://i.ytimg.com/vi/' + id + '/hqdefault.jpg';
			thumbnail.alt = '';
			thumbnail.loading = 'lazy';

			var icon = document.createElement('span');
			icon.className = 'yt-icon';
			icon.setAttribute('aria-hidden', 'true');
			button.append(thumbnail, icon);
			container.append(button);

			button.addEventListener('click', function () {
				var frame = document.createElement('iframe');
				frame.src =
					'https://www.youtube-nocookie.com/embed/' +
					id +
					'?autoplay=1&rel=0';
				frame.title = 'YouTube 영상';
				frame.allow =
					'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
				frame.allowFullscreen = true;
				container.replaceChildren(frame);
			});
		});
	})();
</script>
