---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { categoryLabel } from '../categories';

type Props = CollectionEntry<'blog'>['data'];

// About 페이지도 이 레이아웃을 쓰는데 거기엔 카테고리가 없다. 그래서 선택값으로 받는다.
const { title, description, pubDate, updatedDate, category, heroImage } =
	Astro.props;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header class="post-header settle">
					<h1>{title}</h1>
					<p class="meta">
						{
							category && (
								<>
									<a class="cat" href={`/blog/category/${category}/`}>
										{categoryLabel(category)}
									</a>
									<span aria-hidden="true"> · </span>
								</>
							)
						}
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="updated">
									· updated <FormattedDate date={updatedDate} />
								</span>
							)
						}
						<span id="reading-time"></span>
					</p>
				</header>

				{
						heroImage && (
							<Image
								class="hero settle"
								style="--d: 60ms"
								src={heroImage}
								alt=""
								widths={[480, 800, 1344]}
								sizes="(max-width: 42rem) 100vw, 42rem"
								loading="eager"
							/>
						)
					}

					<div class="prose post-body settle" style="--d: 90ms">
					<slot />
				</div>

				<footer class="post-footer settle" style="--d: 180ms">
					<a href="/blog"><span class="arrow" aria-hidden="true">←</span> All posts</a>
				</footer>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-header {
		margin-bottom: 2.4rem;
	}
	.post-header h1 {
		font-size: 1.75rem;
		line-height: 1.35;
		margin-bottom: 0.8rem;
	}
	.meta {
		font-family: var(--mono);
		font-size: 0.78rem;
		color: var(--faint);
		margin: 0;
	}
	.hero {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 1;
		object-fit: cover;
		border-radius: 8px;
		margin-bottom: 2.4rem;
	}
	.cat {
		color: var(--accent);
		background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px
			no-repeat;
		padding-bottom: 3px;
		transition: background-size 0.25s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.cat:hover {
		background-size: 100% 1px;
	}
	.post-footer {
		border-top: 1px solid var(--border);
		margin-top: 3.5rem;
		padding-top: 1.6rem;
	}
	.post-footer a {
		font-family: var(--mono);
		font-size: 0.82rem;
		color: var(--muted);
	}
	.post-footer a:hover {
		color: var(--text);
	}
	.post-footer .arrow {
		display: inline-block;
		transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.post-footer a:hover .arrow {
		transform: translateX(-3px);
	}
</style>

<script is:inline>
	(function () {
		var el = document.getElementById('reading-time');
		var body = document.querySelector('.post-body');
		if (!el || !body) return;
		var chars = (body.textContent || '').replace(/\s+/g, '').length;
		var min = Math.max(1, Math.round(chars / 500));
		el.textContent = ' · ' + min + ' min read';
	})();
</script>
