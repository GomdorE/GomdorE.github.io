---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate } = Astro.props;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header class="post-header settle">
					<h1>{title}</h1>
					<p class="meta">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="updated">
									· updated <FormattedDate date={updatedDate} />
								</span>
							)
						}
						<span id="reading-time"></span>
					</p>
				</header>

				<div class="prose post-body settle" style="--d: 90ms">
					<slot />
				</div>

				<footer class="post-footer settle" style="--d: 180ms">
					<a href="/blog"><span class="arrow" aria-hidden="true">←</span> All posts</a>
				</footer>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-header {
		margin-bottom: 2.4rem;
	}
	.post-header h1 {
		font-size: 1.75rem;
		line-height: 1.35;
		margin-bottom: 0.8rem;
	}
	.meta {
		font-family: var(--mono);
		font-size: 0.78rem;
		color: var(--faint);
		margin: 0;
	}
	.post-footer {
		border-top: 1px solid var(--border);
		margin-top: 3.5rem;
		padding-top: 1.6rem;
	}
	.post-footer a {
		font-family: var(--mono);
		font-size: 0.82rem;
		color: var(--muted);
	}
	.post-footer a:hover {
		color: var(--text);
	}
	.post-footer .arrow {
		display: inline-block;
		transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.post-footer a:hover .arrow {
		transform: translateX(-3px);
	}
</style>

<script is:inline>
	(function () {
		var el = document.getElementById('reading-time');
		var body = document.querySelector('.post-body');
		if (!el || !body) return;
		var chars = (body.textContent || '').replace(/\s+/g, '').length;
		var min = Math.max(1, Math.round(chars / 500));
		el.textContent = ' · ' + min + ' min read';
	})();
</script>
