---
import type { CollectionEntry } from 'astro:content';

interface Props {
	/** 최신순으로 정렬해서 넘길 것. */
	posts: CollectionEntry<'blog'>[];
	/** 위쪽 요소들이 먼저 등장한 뒤 이어지도록 하는 시작 지연값. */
	baseDelay?: number;
}

const { posts, baseDelay = 180 } = Astro.props;

const byYear = new Map<number, CollectionEntry<'blog'>[]>();
for (const post of posts) {
	const y = post.data.pubDate.getFullYear();
	if (!byYear.has(y)) byYear.set(y, []);
	byYear.get(y)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

// 연도별로 나눠 그리지만, 등장 순서는 목록 전체를 기준으로 매긴다.
// 그래야 연도가 바뀌어도 위에서 아래로 한 줄기로 이어져 보인다.
const order = new Map(posts.map((p, i) => [p.id, i]));

const pad = (n: number) => String(n).padStart(2, '0');
const md = (d: Date) => `${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
---

{
	years.map((year) => (
		<section class="group">
			<h2
				class="label settle"
				style={`--d: ${baseDelay - 60 + (order.get(byYear.get(year)![0].id) ?? 0) * 40}ms`}
			>
				{year}
			</h2>
			<ul>
				{byYear.get(year)!.map((post) => (
					<li
						class="settle"
						style={`--d: ${baseDelay + (order.get(post.id) ?? 0) * 40}ms`}
					>
						<a href={`/blog/${post.id}/`}>
							<time datetime={post.data.pubDate.toISOString()}>
								{md(post.data.pubDate)}
							</time>
							<span class="body">
								<span class="title">{post.data.title}</span>
								{post.data.description && (
									<span class="desc">{post.data.description}</span>
								)}
							</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	))
}

{posts.length === 0 && <p class="empty">아직 이 분류에 쓴 글이 없습니다.</p>}

<style>
	.group {
		margin-top: 2.2rem;
	}
	.group .label {
		display: block;
		padding-bottom: 0.6rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 0.4rem;
	}
	.group ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.group a {
		display: flex;
		gap: 1.2rem;
		padding: 0.65rem 0;
		align-items: baseline;
	}
	.group time {
		font-size: 0.78rem;
		color: var(--faint);
		flex-shrink: 0;
		width: 3.1rem;
		transition: color 0.2s ease;
	}
	.group a:hover time {
		color: var(--muted);
	}
	.group .body {
		min-width: 0;
	}
	.group .title {
		display: block;
		color: var(--text);
		font-weight: 500;
		transition: color 0.15s ease;
	}
	.group a:hover .title {
		color: var(--accent);
	}
	.group .desc {
		display: block;
		color: var(--muted);
		font-size: 0.875rem;
		line-height: 1.65;
		margin-top: 0.15rem;
	}
	.empty {
		color: var(--muted);
		margin-top: 1.5rem;
	}
</style>
