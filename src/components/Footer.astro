---
const today = new Date();
---

<footer>
	<div class="inner">
		<span>© {today.getFullYear()} gomdore</span>
		<span class="links">
			<a href="/rss.xml">RSS</a>
		</span>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
	}
	.inner {
		width: 42rem;
		max-width: calc(100% - 2.5rem);
		margin: 0 auto;
		padding: 1.6rem 0 2.4rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-family: var(--mono);
		font-size: 0.78rem;
		color: var(--faint);
	}
	.links a {
		color: var(--faint);
	}
	.links a:hover {
		color: var(--text);
	}
</style>
