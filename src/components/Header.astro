---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<div class="inner">
		<a class="brand" href="/">{SITE_TITLE}<span class="cursor" aria-hidden="true">_</span></a>
		<nav>
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Posts</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</nav>
	</div>
</header>

<style>
	header {
		border-bottom: 1px solid var(--border);
	}
	.inner {
		width: 42rem;
		max-width: calc(100% - 2.5rem);
		margin: 0 auto;
		padding: 1.4rem 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.brand {
		font-family: var(--mono);
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--text);
	}
	.cursor {
		color: var(--accent);
		animation: blink 1.2s step-end infinite;
	}
	@media (prefers-reduced-motion: reduce) {
		.cursor {
			animation: none;
		}
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	nav {
		display: flex;
		gap: 1.4rem;
	}
	nav :global(a) {
		font-family: var(--mono);
		font-size: 0.82rem;
		color: var(--muted);
		transition: color 0.15s ease;
	}
	nav :global(a:hover) {
		color: var(--text);
	}
	/* 현재 페이지 표시. 밑줄을 배경으로 그려야 hover 에서 자라나는
	   연출과 같은 방식으로 다룰 수 있다. */
	nav :global(a.active) {
		color: var(--text);
		background: linear-gradient(var(--accent), var(--accent)) 0 100% / 100% 2px
			no-repeat;
		padding-bottom: 4px;
	}
	/* 현재 페이지가 아닌 항목은 hover 할 때 밑줄이 왼쪽에서 자라난다. */
	nav :global(a:not(.active)) {
		background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 2px
			no-repeat;
		padding-bottom: 4px;
		transition:
			color 0.15s ease,
			background-size 0.25s cubic-bezier(0.22, 1, 0.36, 1);
	}
	nav :global(a:not(.active):hover) {
		background-size: 100% 2px;
	}
	@media (max-width: 640px) {
		nav {
			gap: 1rem;
		}
	}
</style>
