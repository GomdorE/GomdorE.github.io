---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<div class="inner">
		<a class="brand" href="/">{SITE_TITLE}<span class="cursor" aria-hidden="true">_</span></a>
		<nav aria-label="주요 메뉴">
			<HeaderLink href="/">홈</HeaderLink>
			<HeaderLink href="/blog">전체 글</HeaderLink>
			<HeaderLink href="/about">운영 원칙</HeaderLink>
		</nav>
	</div>
</header>

<style>
	header {
		border-bottom: 1px solid var(--border);
	}
	.inner {
		width: 68rem;
		max-width: calc(100% - 2.5rem);
		margin: 0 auto;
		padding: 1.4rem 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.brand {
		font-family: var(--mono);
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--text);
	}
	/* .cursor 스타일은 global.css 에 모아두었다. */
	nav {
		display: flex;
		gap: 1.4rem;
	}
	nav :global(a) {
		font-family: var(--mono);
		font-size: 0.82rem;
		color: var(--muted);
		transition: color 0.15s ease;
	}
	nav :global(a:hover) {
		color: var(--text);
	}
	/* 현재 페이지 표시. 밑줄을 배경으로 그려야 hover 에서 자라나는
	   연출과 같은 방식으로 다룰 수 있다. */
	nav :global(a.active) {
		color: var(--text);
		background: linear-gradient(var(--accent), var(--accent)) 0 100% / 100% 2px
			no-repeat;
		padding-bottom: 4px;
	}
	/* 현재 페이지가 아닌 항목은 hover 할 때 밑줄이 왼쪽에서 자라난다. */
	nav :global(a:not(.active)) {
		background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 2px
			no-repeat;
		padding-bottom: 4px;
		transition:
			color 0.15s ease,
			background-size 0.25s cubic-bezier(0.22, 1, 0.36, 1);
	}
	nav :global(a:not(.active):hover) {
		background-size: 100% 2px;
	}
	@media (max-width: 640px) {
		nav {
			gap: 1rem;
		}
	}
</style>

<script is:inline>
	// 스크롤하는 동안 <html> 에 표식을 달아, 커서 깜빡임을 잠시 멈춘다.
	// 멈추는 것 자체보다, 멈췄다가 다시 깜빡이기 시작하는 순간이 핵심이다.
	(function () {
		var root = document.documentElement;
		var idle;
		addEventListener(
			'scroll',
			function () {
				root.classList.add('is-reading');
				clearTimeout(idle);
				idle = setTimeout(function () {
					root.classList.remove('is-reading');
				}, 900);
			},
			{ passive: true },
		);
	})();
</script>
