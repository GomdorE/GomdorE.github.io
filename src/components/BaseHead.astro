---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-4.jpg';
import { SITE_AUTHOR, SITE_TITLE, SITE_URL } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	/** 글 페이지에서는 article. 검색엔진과 SNS가 목록 페이지와 구분해서 다룬다. */
	type?: 'website' | 'article';
	pubDate?: Date;
	updatedDate?: Date;
	category?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = FallbackImage,
	type = 'website',
	pubDate,
	updatedDate,
	category,
} = Astro.props;

const imageURL = new URL(image.src, Astro.url);
const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;

// 구조화 데이터. 구글이 글 제목·날짜·대표 이미지를 정확히 읽어가게 해준다.
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': type === 'article' ? 'BlogPosting' : 'WebSite',
	headline: title,
	name: title,
	description,
	url: canonicalURL.href,
	image: imageURL.href,
	inLanguage: 'ko-KR',
	...(type === 'article' && pubDate
		? { datePublished: pubDate.toISOString() }
		: {}),
	...(type === 'article' && pubDate
		? { dateModified: (updatedDate ?? pubDate).toISOString() }
		: {}),
	...(type === 'article'
		? {
				articleSection: category,
				author: { '@type': 'Person', name: SITE_AUTHOR, url: `${SITE_URL}/about/` },
				publisher: {
					'@type': 'Organization',
					name: SITE_TITLE,
					url: SITE_URL,
				},
				mainEntityOfPage: canonicalURL.href,
			}
		: {}),
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!--
	글꼴은 global.css 에서 직접 불러온다(@import). 외부 CDN 을 쓰지 않으므로
	여기에 preconnect 나 stylesheet 링크가 필요 없다.
-->

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content="index,follow,max-image-preview:large" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="ko_KR" />
{
	type === 'article' && pubDate && (
		<meta property="article:published_time" content={pubDate.toISOString()} />
	)
}
{
	type === 'article' && updatedDate && (
		<meta property="article:modified_time" content={updatedDate.toISOString()} />
	)
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
